# Uncomment this line to define a global platform for your project
# Apple exige iOS 15.0 minimo para subir a App Store Connect (aviso 90068).
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Todo el arbol de pods al mismo minimo que la app. CocoaPods respeta el
    # `platform` de cada podspec, asi que awesome_notifications_fcm se quedaba
    # en 13.0 y no podia importar awesome_notifications, cuyo core exige 15.0.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # El podspec de IosAwnFcmCore trae SKIP_INSTALL = NO, asi que Xcode lo
      # instalaba en Products/Library/Frameworks del archive. Un archive con
      # productos sueltos ademas de la app se degrada a 'Generic Xcode
      # Archive': se queda sin ApplicationProperties en su Info.plist y
      # exportArchive rechaza todos los metodos de distribucion de iOS
      # ('expected one {}'). Ningun pod debe instalarse junto a la app.
      config.build_settings['SKIP_INSTALL'] = 'YES'
    end
  end

  # IosAwnCore / IosAwnFcmCore (dependencias de awesome_notifications) piden
  # BUILD_LIBRARY_FOR_DISTRIBUTION = YES y CocoaPods lo propaga al xcconfig
  # del target Runner. Con evolucion de biblioteca activa, Swift rechaza el
  # bridging header de la app: "Using bridging headers with module interfaces
  # is unsupported". Lo quitamos solo del target de la app; cada pod conserva
  # el suyo en su propio xcconfig, que es donde de verdad hace falta.
  Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Runner*', '*.xcconfig')).each do |path|
    contents = File.read(path)
    stripped = contents.gsub(/^BUILD_LIBRARY_FOR_DISTRIBUTION = .*\n/, '')
    File.write(path, stripped) unless stripped == contents
  end
end
